{
  "title": "AgentWatch · Operational reliability",
  "uid": "agentwatch", "schemaVersion": 39, "version": 1,
  "refresh": "15s", "time": {"from":"now-1h","to":"now"},
  "panels": [
    {"id":1,"title":"Request rate","type":"timeseries","gridPos":{"x":0,"y":0,"w":12,"h":8},"datasource":{"uid":"agentwatch-prometheus","type":"prometheus"},"targets":[{"expr":"rate(agent_requests_total[5m])","legendFormat":"requests / second"}]},
    {"id":2,"title":"P95 agent latency (seconds)","type":"timeseries","gridPos":{"x":12,"y":0,"w":12,"h":8},"datasource":{"uid":"agentwatch-prometheus","type":"prometheus"},"targets":[{"expr":"histogram_quantile(0.95, sum(rate(agent_latency_seconds_bucket[5m])) by (le))","legendFormat":"P95"}]},
    {"id":3,"title":"Tool error ratio","type":"timeseries","gridPos":{"x":0,"y":8,"w":12,"h":8},"datasource":{"uid":"agentwatch-prometheus","type":"prometheus"},"targets":[{"expr":"rate(tool_failures_total[5m]) / clamp_min(rate(tool_calls_total[5m]), 0.0001)","legendFormat":"tool errors"}]},
    {"id":4,"title":"Mean lexical grounding proxy","type":"timeseries","gridPos":{"x":12,"y":8,"w":12,"h":8},"datasource":{"uid":"agentwatch-prometheus","type":"prometheus"},"targets":[{"expr":"rate(faithfulness_score_sum[5m]) / clamp_min(rate(faithfulness_score_count[5m]), 0.0001)","legendFormat":"grounding proxy"}]}
  ]
}
