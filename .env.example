DEMO_MODE=true
DATABASE_URL=sqlite:///./runtime/agentwatch.db
SEED_ON_START=true
DEMO_LATENCY_SCALE=1.0
ONLINE_EVAL_SAMPLE_RATE=0.10
DEMO_EVAL_SAMPLE_RATE=1.0
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK=false
MAX_CONCURRENT_RUNS=4
API_KEY=
MIN_FAITHFULNESS=0.80
MIN_CONTEXT_RECALL=0.75
MIN_CITATION_ACCURACY=0.95
MAX_P95_LATENCY_MS=5000
MAX_REGRESSION_PERCENT=10
INPUT_COST_PER_1M=0.15
OUTPUT_COST_PER_1M=0.60
COST_PROFILE=production-model-A
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
DEEPEVAL_TELEMETRY_OPT_OUT=YES
LANGSMITH_TRACING=false
MIN_LATENCY_REGRESSION_MS=100

# Shared budgets per server process (all visitors combined; not per IP).
PUBLIC_REQUESTS_PER_MINUTE=30
PUBLIC_BENCHMARKS_PER_10_MINUTES=2
PUBLIC_MAX_ACTIVE=4
PUBLIC_MAX_BODY_BYTES=16384
PUBLIC_REQUEST_TIMEOUT_SECONDS=180
LLM_TIMEOUT_SECONDS=60
# Live generation works with lightweight TF-IDF; install .[local] for semantic retrieval.
SEMANTIC_RETRIEVAL=false
LLM_TOOL_SELECTION=true
LLM_MAX_OUTPUT_TOKENS=180
LIVE_GENERATION_RETRIES=0
STRUCTURED_ANSWERS=false
SPAN_LATENCY_BUDGET_MS=2000
REQUEST_LATENCY_BUDGET_MS=5000
